{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "strict": false,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/main.ts",
    "src/domain/**/*.ts",
    "src/server/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".tmp/next/types/**/*.ts",
    ".tmp/next/dev/types/**/*.ts",
    ".tmp/next-service-dev/types/**/*.ts",
    ".tmp/next-service-dev/dev/types/**/*.ts",
    ".tmp/next-service-build/types/**/*.ts",
    ".tmp/next-service-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "src/backup"
  ]
}
