{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chartwin",
  "main": "./worker/index.js",
  "compatibility_date": "2026-06-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "CANDLES_KV",
      "id": "7dae3d119aba44a8a8a268d82b4e0fe7"
    }
  ]
}
