{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chartwin",
  "compatibility_date": "2026-05-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./cloudflare-worker.ts",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_ENV": "production",
    "CHART_SERVICE_RUNTIME_TARGET": "cloudflare-workers",
    "CHART_SERVICE_BASE_URL": "https://tradingcore.co",
    "CHART_SERVICE_REPOSITORY": "postgres",
    "CHART_SERVICE_DATABASE_SSL_MODE": "require",
    "CHART_SERVICE_EMAIL_PROVIDER": "cloudflare",
    "CHART_SERVICE_EMAIL_DELIVERY_LIMIT": "50",
    "CHART_SERVICE_TELEGRAM_CRON_ENABLED": "true",
    "DATA_GATEWAY_PUBLIC_URL": "https://gateway.tradingcore.co"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "verify@tradingcore.co",
        "auth@tradingcore.co",
        "support@tradingcore.co",
        "noreply@tradingcore.co"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
