{
  "name": "my-chart-lib",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev-full.mjs",
    "frontend:dev": "vite",
    "backend:dev": "node server/data-gateway.mjs",
    "service:dev": "next dev --hostname 127.0.0.1 --port 3000",
    "service:build": "node scripts/run-next-build.mjs",
    "service:launch-guide": "node scripts/print-chart-service-launch-guide.mjs",
    "service:release-gap-report": "node scripts/print-chart-service-release-gap-report.mjs",
    "service:check": "node scripts/check-production-readiness.mjs",
    "service:prod-env:check": "node scripts/check-production-env.mjs",
    "service:smoke": "node scripts/run-chart-service-smoke.mjs",
    "service:security": "node --test tests/chart-service-security.test.mjs tests/chart-service-admin-mutation-async-routes.test.mjs tests/chart-service-user-async-routes.test.mjs tests/chart-service-payment-settings.test.mjs",
    "service:verify": "node scripts/run-chart-service-release-gate.mjs",
    "service:launch-check": "node scripts/run-chart-service-launch-check.mjs",
    "service:postgres:gate": "node scripts/run-chart-service-postgres-gate.mjs",
    "service:postgres:admin-check": "node scripts/verify-postgres-admin-login.mjs",
    "service:postdeploy:smoke": "node scripts/run-chart-service-postdeploy-smoke.mjs",
    "service:bootstrap": "node scripts/bootstrap-chart-service.mjs",
    "service:email:deliver": "node scripts/deliver-email-outbox.mjs",
    "service:migrate": "node scripts/run-chart-service-migration.mjs",
    "service:schema": "node scripts/write-chart-service-schema.mjs",
    "service:cloudflare:build": "node scripts/run-open-next-cloudflare-build.mjs",
    "service:cloudflare:preview": "npm run service:cloudflare:build && wrangler dev",
    "service:cloudflare:deploy": "npm run service:cloudflare:build && wrangler deploy",
    "build": "tsc -p tsconfig.vite.json && vite build",
    "preview": "vite preview",
    "preview:cloudflare": "npm run build && wrangler pages dev dist",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name chartwin",
    "deploy:cloudflare:prod": "npm run build && wrangler pages deploy dist --project-name chartwin --branch main",
    "preview:cloudflare:next": "npm run service:cloudflare:preview",
    "deploy:cloudflare:next": "npm run service:cloudflare:deploy"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@types/moo": "^0.5.10",
    "@types/nearley": "^2.11.5",
    "@types/node": "25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "wrangler": "^4.93.0"
  },
  "dependencies": {
    "@tiptap/extension-color": "^3.24.0",
    "@tiptap/extension-highlight": "^3.24.0",
    "@tiptap/extension-link": "^3.24.0",
    "@tiptap/extension-subscript": "^3.24.0",
    "@tiptap/extension-superscript": "^3.24.0",
    "@tiptap/extension-table": "^3.24.0",
    "@tiptap/extension-table-cell": "^3.24.0",
    "@tiptap/extension-table-header": "^3.24.0",
    "@tiptap/extension-table-row": "^3.24.0",
    "@tiptap/extension-task-item": "^3.24.0",
    "@tiptap/extension-task-list": "^3.24.0",
    "@tiptap/extension-text-align": "^3.24.0",
    "@tiptap/extension-text-style": "^3.24.0",
    "@tiptap/extension-underline": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "lucide-react": "^1.17.0",
    "moo": "^0.5.3",
    "nearley": "^2.20.1",
    "next": "^16.2.6",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "technicalindicators": "^3.1.0"
  }
}
