# TradingCore production environment template
# Do not commit real production values. Copy this file to your hosting secret
# manager or local deployment environment, then fill the blank values there.
# Before release, run: npm.cmd run service:postgres:gate

NODE_ENV=production
CHART_SERVICE_REPOSITORY=postgres

# Required Postgres connection. Keep the committed template blank.
CHART_SERVICE_DATABASE_URL=
CHART_SERVICE_DATABASE_SSL_MODE=require

# Required in production. Use at least 32 random characters.
CHART_SERVICE_SESSION_SECRET=

# Current delivery harness uses the log provider until an external provider is wired.
CHART_SERVICE_EMAIL_PROVIDER=log
CHART_SERVICE_EMAIL_DELIVERY_LIMIT=50

# First launch and Postgres gate admin login check. Fill only in the secret manager/runtime env.
CHART_SERVICE_BOOTSTRAP_ADMIN_EMAIL=
CHART_SERVICE_BOOTSTRAP_ADMIN_PASSWORD=
CHART_SERVICE_BOOTSTRAP_ADMIN_NAME=
