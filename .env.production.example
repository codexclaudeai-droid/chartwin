# TradingCore production environment template
# Do not commit real production values. Copy this file to your hosting secret
# manager or local deployment environment, then fill the blank values there.
# Before release, run: npm.cmd run service:postgres:gate

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN
CHART_SERVICE_REPOSITORY=postgres

# Required Postgres connection. Keep the committed template blank.
CHART_SERVICE_DATABASE_URL=
CHART_SERVICE_DATABASE_SSL_MODE=require

# Optional Cloudflare Hyperdrive deployment controls.
# If CLOUDFLARE_HYPERDRIVE_ID is set, deployment binds that existing config
# without calling the Hyperdrive create/list API.
CLOUDFLARE_HYPERDRIVE_NAME=tradingcore-hyperdrive
CLOUDFLARE_HYPERDRIVE_ID=
CLOUDFLARE_HYPERDRIVE_BINDING=HYPERDRIVE
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Required in production. Use at least 32 random characters.
CHART_SERVICE_SESSION_SECRET=

# Transactional email delivery. GitHub Actions can keep CLOUDFLARE_ACCOUNT_ID
# and CLOUDFLARE_API_TOKEN, then upload them to Worker runtime as the
# CHART_SERVICE_CLOUDFLARE_* app secrets below.
CHART_SERVICE_EMAIL_PROVIDER=cloudflare
CHART_SERVICE_EMAIL_DELIVERY_LIMIT=50
CHART_SERVICE_CLOUDFLARE_ACCOUNT_ID=
CHART_SERVICE_CLOUDFLARE_API_TOKEN=

# Browser Web Push. Generate with: node scripts/generate-vapid-keys.mjs
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# First launch and Postgres gate admin login check. Fill only in the secret manager/runtime env.
CHART_SERVICE_BOOTSTRAP_ADMIN_EMAIL=
CHART_SERVICE_BOOTSTRAP_ADMIN_PASSWORD=
CHART_SERVICE_BOOTSTRAP_ADMIN_NAME=
